# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example is committable: no secrets, documents required vars)
.env*
!.env.example

# vercel
.vercel

# app data (generated locally, never committed)
/data/*.db
/data/*.db-*
/data/cache/*
!/data/cache/.gitkeep
/data/backups/*
!/data/backups/.gitkeep
/data/imports/*
!/data/imports/.gitkeep
/data/campioncini/*
!/data/campioncini/.gitkeep

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local session settings (machine/session-specific)
.claude/settings.local.json
