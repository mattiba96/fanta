# Anthropic API key, usata solo dalla chat AI (server-side, mai esposta al browser)
ANTHROPIC_API_KEY=

# Modello Claude usato dalla chat AI
ANTHROPIC_MODEL=claude-opus-5

# Percorso del database SQLite. Di default dentro il progetto (che vive fuori iCloud),
# quindi va bene lasciarlo relativo.
DATABASE_PATH=./data/fanta.db
